#!/usr/bin/env bash
# 入庫前掃描（CLAUDE.md 資安 8）：gitleaks 掃暫存區的祕密，ruff 檢查後端程式（含 S 資安規則）。
# 安裝：scripts/install-hooks.sh（設定 core.hooksPath）。不要用 --no-verify 跳過。
set -euo pipefail
ROOT="$(git rev-parse --show-toplevel)"

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit：找不到 gitleaks，請先安裝（brew install gitleaks）" >&2
  exit 1
fi
gitleaks git --pre-commit --staged --redact --no-banner "$ROOT"

if git diff --cached --name-only --diff-filter=ACM | grep -q '^backend/.*\.py$'; then
  RUFF="$ROOT/backend/.venv/bin/ruff"
  [ -x "$RUFF" ] || RUFF="$ROOT/backend/.venv/Scripts/ruff.exe"   # Windows venv
  "$RUFF" check "$ROOT/backend"
fi
