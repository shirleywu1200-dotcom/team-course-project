# 複製為 env/local.env 後填入實際值；本檔只放外流也無妨的範例值
G4_DATABASE_URL=postgresql+psycopg://g4:<密碼>@127.0.0.1:5433/g4
G4_TEST_ADMIN_URL=postgresql+psycopg://g4:<密碼>@127.0.0.1:5433/postgres
G4_API_TOKEN=<以 python -c "import secrets;print(secrets.token_urlsafe(32))" 產生>
G4_BIND_HOST=127.0.0.1
G4_PORT=8000
# 真實 AI（13.4）：預設 off，不呼叫供應商；設為 anthropic 並在 local.env 填 key 才啟用，會產生費用
AI_PROVIDER=off
AI_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=<只放 env/local.env>
