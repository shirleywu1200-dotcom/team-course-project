  "components": {
    "schemas": {
      "AdjustDue": {
        "properties": {
          "expected_version": {
            "type": "integer",
            "title": "Expected Version"
          },
          "new_due": {
            "type": "string",
            "format": "date",
            "title": "New Due"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          },
          "note": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Note"
          },
          "mark": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "better",
                  "worse",
                  "none"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Mark"
          },
          "defer_mark": {
            "type": "boolean",
            "title": "Defer Mark",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "expected_version",
          "new_due"
        ],
        "title": "AdjustDue"
      },
      "Annotation": {
        "properties": {
          "mark": {
            "type": "string",
            "enum": [
              "better",
              "worse",
              "none"
            ],
            "title": "Mark"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          },
          "note": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Note"
          }
        },
        "type": "object",
        "required": [
          "mark"
        ],
        "title": "Annotation"
      },
      "BaselineCommit": {
        "properties": {
          "confirmation_token": {
            "type": "string",
            "title": "Confirmation Token"
          },
          "ack": {
            "type": "boolean",
            "title": "Ack",
            "default": false
