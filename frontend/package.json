{
  "name": "g4-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run && npm run test:tooling",
    "openapi:export": "node scripts/openapi.mjs export",
    "types:generate": "node scripts/openapi.mjs generate",
    "types:check": "node scripts/openapi.mjs check",
    "openapi:check": "node scripts/openapi.mjs check-export",
    "test:tooling": "node --test scripts/openapi.checks.mjs",
    "format:check": "git diff --check -- . && git diff --cached --check -- ."
  },
  "dependencies": {
    "@tanstack/react-query": "^5.107.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^26.1.0",
    "msw": "^2.15.0",
    "openapi-typescript": "7.13.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.6",
    "vitest": "^3.2.7"
  }
}
